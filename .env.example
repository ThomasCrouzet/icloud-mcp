# Example environment for any MCP host (or a shell that exports these vars).
# The binary is host-agnostic: it does not parse .env files or vendor configs.
# It recognizes exactly the 12 product variables below. Never commit real
# identities, passwords, or recipients.

# Required Calendar identity. Contacts reuses a separate in-memory copy.
# file:// is supported (regular file, at most 4 KiB, mode 0600 or stricter),
# for example file:///run/secrets/icloud-email.
ICLOUD_EMAIL=

# Required app-specific password, never the main Apple Account password.
# Contacts uses a copy, and Mail uses it when ICLOUD_MAIL_PASSWORD is unset.
# file:// is supported with the same regular-file and 0600 rules.
ICLOUD_PASSWORD=

# Global mutation kill switch. Default false; true is recommended initially.
# Every boolean accepts only unset, 0, false, 1, or true after trimming and
# case folding. Invalid non-empty values fail at boot.
ICLOUD_MCP_READ_ONLY=true

# Structured stderr log level. Trimmed, case-insensitive forms: debug/-4,
# info, warn/warning/2, and error/4. Unset or unrecognized values use info.
ICLOUD_MCP_LOG_LEVEL=info

# IANA timezone for Calendar date-time inputs without an RFC3339 offset and as
# the recurring-write timezone fallback. Default UTC.
ICLOUD_MCP_DEFAULT_TZ=Europe/Paris

# Optional Contacts reads. Writes are also registered when global read-only is
# false. Search uses bounded server prefilters plus combined local filtering;
# digit-normalized phone-only search uses a bounded all-card query. Default false.
ICLOUD_MCP_ENABLE_CONTACTS=false

# Optional Mail reads. Enabling Mail requires ICLOUD_MAIL_ADDRESS. Default false.
ICLOUD_MCP_ENABLE_MAIL=false

# Full iCloud Mail address, which may differ from ICLOUD_EMAIL. Read only when
# Mail is enabled. file:// is supported (regular file, <=4 KiB, mode 0600+).
ICLOUD_MAIL_ADDRESS=

# Optional dedicated Mail app-specific password. If unset while Mail is enabled,
# ICLOUD_PASSWORD is copied into the Mail credential object. file:// as above.
ICLOUD_MAIL_PASSWORD=

# Request set_message_flags, move_message, and trash_message. Requires Mail;
# global read-only still suppresses registration. On CONDSTORE servers,
# set_message_flags currently fails closed with protocol_error before STORE
# because go-imap beta.8 cannot expose tagged MODIFIED. Default false.
ICLOUD_MCP_ENABLE_MAIL_WRITE=false

# Request send_message independently from Mail mutation. Requires Mail and a
# valid recipient policy even under global read-only. The tool's to, cc, and bcc
# arrays are each optional, but at least one aggregate recipient is required.
# Default false.
ICLOUD_MCP_ENABLE_MAIL_SEND=false

# Exact comma-separated plain addresses, or literal * as the complete value.
# Prefer exact addresses in production. Literal * allows any recipient after
# AUTH and logs a boot warning. No display names, groups, suffix/domain rules,
# partial wildcards, empty items, or duplicates. Matching is ASCII
# case-insensitive. file:// is not supported.
ICLOUD_MCP_SMTP_ALLOWED_RECIPIENTS=

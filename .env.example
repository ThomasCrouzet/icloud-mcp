# Example variables for an MCP host or a shell that exports them.
# The binary works with any host. It does not read .env files or vendor configurations.
# It recognizes only the 14 product variables below.
# Never commit real identities, passwords, or recipients.
# Choose a tested host profile from examples/profiles. The first three are read-only.

# Calendar/Contacts identity. Not needed for an explicit Mail-only permission list.
# Contacts uses a separate copy in memory.
# You can use file://, for example file:///run/secrets/icloud-email.
# The file must be a regular file, at most 4 KiB, with mode 0600 or stricter.
ICLOUD_EMAIL=

# App-specific password for Calendar/Contacts or Mail fallback. Never use the main password.
# Mail-only profiles use ICLOUD_MAIL_PASSWORD without unused Calendar credentials.
# Contacts uses a copy. Mail uses it when ICLOUD_MAIL_PASSWORD is unset.
# You can use file:// with the same file type, size, and permission limits.
ICLOUD_PASSWORD=

# Global read-only control. The default is false.
# Effects are never implied: Calendar and Contacts writes, Mail mutation, and
# Mail send require their exact ICLOUD_MCP_PERMISSIONS tokens. An unset value
# with no permission list still exposes reads only.
# Keep true for the first run and for any read-only deployment.
# Each boolean accepts only unset, 0, false, 1, or true.
# The parser removes surrounding whitespace and ignores letter case.
# Invalid non-empty values cause startup to fail.
# Hosts that require string values reject an unquoted YAML boolean.
# Quote a boolean in YAML, for example ICLOUD_MCP_READ_ONLY: "false".
ICLOUD_MCP_READ_ONLY=true

# Explicit capability list. Empty means reads only for the enabled domains.
# Name every effect you grant; a domain switch never grants one.
# Use a comma-separated list of these tokens:
#   calendar.read, calendar.write, calendar.delete,
#   contacts.read, contacts.write, contacts.delete,
#   mail.read, mail.mutate, mail.trash, mail.send, mail.archive
# Domain switches below still enable Contacts and Mail. Global read-only still
# removes every mutation and send.
# Recommended Calendar first run: calendar.read, with global read-only=true.
# Optional gates alone grant no capabilities under an explicit permission list.
ICLOUD_MCP_PERMISSIONS=

# Optional resource allowlists. Semicolon-separated action=value[,value] entries.
# Actions: calendar.read, calendar.write, calendar.delete,
#          contacts.read, contacts.write, contacts.delete,
#          mail.read, mail.mutate, mail.archive.
# Calendar values are paths. Contacts values are identifiers or exact names.
# Mail values are exact mailbox names. A single * means unrestricted.
# Unset write/delete/mutate scopes fall back to the domain read scope.
# Example: calendar.read=/cal/home/,/cal/work/;calendar.write=/cal/home/;mail.read=INBOX;mail.archive=Sent
ICLOUD_MCP_RESOURCE_SCOPES=

# Level for structured stderr logs. The parser removes surrounding whitespace
# and ignores letter case. Values: debug/-4, info, warn/warning/2, and error/4.
# Unset or unknown values use info.
ICLOUD_MCP_LOG_LEVEL=info

# IANA timezone for Calendar date-time inputs without an RFC3339 offset.
# Recurring writes also use this timezone if no timezone is specified.
# The default is UTC.
ICLOUD_MCP_DEFAULT_TZ=Europe/Paris

# Enable Contacts reads. Writes require contacts.write or contacts.delete in
# ICLOUD_MCP_PERMISSIONS and global read-only false.
# Search uses server filters where possible and limits results.
# It then applies all local filters.
# Phone-only search uses a query of all cards, with a result limit.
# Local phone matching compares digits only. The default is false.
ICLOUD_MCP_ENABLE_CONTACTS=false

# Enable Mail reads. Mail requires ICLOUD_MAIL_ADDRESS. The default is false.
ICLOUD_MCP_ENABLE_MAIL=false

# Full iCloud Mail address. It can differ from ICLOUD_EMAIL.
# The server reads this variable only when Mail is enabled.
# You can use file:// with the same file type, size, and permission limits.
ICLOUD_MAIL_ADDRESS=

# Optional separate app-specific password for Mail.
# If this is unset and Mail is enabled, the server copies ICLOUD_PASSWORD
# into the Mail credential object.
# You can use file:// with the same file type, size, and permission limits.
ICLOUD_MAIL_PASSWORD=

# Legacy compatibility gate for Mail mutation. Mail must be enabled. It does not
# grant a tool: add mail.mutate or mail.trash to ICLOUD_MCP_PERMISSIONS.
# Global read-only prevents registration of these tools.
# On CONDSTORE servers, set_message_flags requires expected_modseq.
# The adapter validates one conditional UID STORE from returned FETCH metadata.
# The default is false.
ICLOUD_MCP_ENABLE_MAIL_WRITE=false

# Legacy compatibility gate for send_message. Mail must be enabled. It does not
# grant the tool: add mail.send to ICLOUD_MCP_PERMISSIONS.
# A valid recipient policy is required, including in global read-only mode.
# The to, cc, and bcc arrays are each optional.
# There must be at least one recipient across these arrays. The default is false.
ICLOUD_MCP_ENABLE_MAIL_SEND=false

# Exact plain addresses, separated by commas, or a single literal *.
# Prefer exact addresses in production.
# Literal * permits any recipient after AUTH. It causes a warning at startup.
# Do not use display names, groups, suffix or domain rules, or partial wildcards.
# Do not use empty items or duplicate addresses.
# Matching ignores ASCII letter case. You cannot use file:// for this variable.
ICLOUD_MCP_SMTP_ALLOWED_RECIPIENTS=
